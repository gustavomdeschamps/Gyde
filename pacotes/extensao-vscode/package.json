{
  "name": "gyde",
  "displayName": "Gyde: tutor de programação com IA",
  "description": "Tutor de programação com IA, em português e grátis: explica o código, mostra onde está o erro e por quê, revisa arquivos e conversa no chat da barra lateral.",
  "version": "1.1.1",
  "publisher": "gustavomdeschamps",
  "author": {
    "name": "Gustavo Moreira Deschamps"
  },
  "license": "MIT",
  "icon": "media/icone.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavomdeschamps/Gyde"
  },
  "homepage": "https://github.com/gustavomdeschamps/Gyde#readme",
  "bugs": {
    "url": "https://github.com/gustavomdeschamps/Gyde/issues"
  },
  "keywords": [
    "ia",
    "ai",
    "tutor",
    "programação",
    "português",
    "iniciante",
    "explicar código",
    "erros",
    "chat",
    "assistente"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gyde",
          "title": "Gyde",
          "icon": "media/barra.svg"
        }
      ]
    },
    "views": {
      "gyde": [
        {
          "type": "webview",
          "id": "gyde.chat",
          "name": "Conversa"
        }
      ]
    },
    "commands": [
      {
        "command": "gyde.abrir",
        "title": "Abrir o chat",
        "category": "Gyde"
      },
      {
        "command": "gyde.novaConversa",
        "title": "Nova conversa",
        "category": "Gyde",
        "icon": "$(add)"
      },
      {
        "command": "gyde.explicar",
        "title": "Explicar com o Gyde",
        "category": "Gyde"
      },
      {
        "command": "gyde.revisar",
        "title": "Revisar com o Gyde",
        "category": "Gyde"
      },
      {
        "command": "gyde.explicarErro",
        "title": "Explicar o erro desta linha",
        "category": "Gyde"
      },
      {
        "command": "gyde.configurar",
        "title": "Conectar (colar token)",
        "category": "Gyde"
      },
      {
        "command": "gyde.desconectar",
        "title": "Desconectar",
        "category": "Gyde"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gyde.explicar",
          "when": "editorHasSelection",
          "group": "gyde@1"
        },
        {
          "command": "gyde.revisar",
          "group": "gyde@2"
        },
        {
          "command": "gyde.explicarErro",
          "group": "gyde@3"
        }
      ],
      "view/title": [
        {
          "command": "gyde.novaConversa",
          "when": "view == gyde.chat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gyde.explicar",
        "key": "ctrl+alt+g",
        "when": "editorHasSelection"
      },
      {
        "command": "gyde.abrir",
        "key": "ctrl+alt+g",
        "when": "!editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Gyde",
      "properties": {
        "gyde.servidor": {
          "type": "string",
          "default": "http://127.0.0.1:3210",
          "description": "Endereço do Gyde (o mesmo que abre no navegador)."
        }
      }
    }
  },
  "scripts": {
    "empacotar": "node empacotar.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3"
  }
}
