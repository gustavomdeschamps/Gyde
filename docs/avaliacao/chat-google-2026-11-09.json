   "texto": "```js\nfunction validarCadastro(corpo) {\n  const erros = [];\n\n  if (!corpo || typeof corpo !== 'object') {\n    return { status: 400, erros: ['email', 'senha', 'idade'] };\n  }\n\n  const { email, senha, idade } = corpo;\n\n  // Validação de e-mail: formato básico \"texto@texto\"\n  const emailRegex = /^.+@.+$/;\n  if (typeof email !== 'string' || !emailRegex.test(email)) {\n    erros.push('email');\n  }\n\n  // Validação de senha: mínimo 8 caracteres\n  if (typeof senha !== 'string' || senha.length < 8) {\n    erros.push('senha');\n  }\n\n  // Validação de idade: opcional, mas se existir deve ser inteiro entre 13 e 120\n  if (idade !== undefined) {\n    const idadeNum = Number(idade);\n    if (!Number.isInteger(idadeNum) || idadeNum < 13 || idadeNum > 120) {\n      erros.push('idade');\n    }\n  }\n\n  if (erros.length > 0) {\n    return { status: 400, erros };\n  }\n\n  return { status: 201, erros: [] };\n}\n```"
