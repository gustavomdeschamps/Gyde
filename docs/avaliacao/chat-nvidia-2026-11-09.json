   "texto": "```js\nfunction validarCadastro(corpo) {\n    const erros = [];\n\n    if (typeof corpo !== 'object' || corpo === null) {\n        return { status: 400, erros: ['email', 'senha', 'idade'] };\n    }\n\n    // Validação do email\n    const email = corpo.email;\n    const emailValido = typeof email === 'string' && \n        /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\n    if (!emailValido) {\n        erros.push('email');\n    }\n\n    // Validação da senha\n    const senha = corpo.senha;\n    if (typeof senha !== 'string' || senha.length < 8) {\n        erros.push('senha');\n    }\n\n    // Validação da idade\n    const idade = corpo.idade;\n    const idadeValida = idade !== undefined && \n        Number.isInteger(idade) && \n        idade >= 13 && \n        idade <= 120;\n    if (!idadeValida) {\n        erros.push('idade');\n    }\n\n    return erros.length === 0 \n        ? { status: 201, erros: [] } \n        : { status: 400, erros };\n}\n```"
