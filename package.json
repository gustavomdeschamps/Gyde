{
  "name": "gyde-monorepo",
  "productName": "Gyde",
  "version": "1.0.0",
  "private": true,
  "description": "Gyde, a IA que ensina programação para iniciantes, com os modelos grátis do FreeLLMAPI.",
  "author": "Gustavo Moreira Deschamps",
  "type": "module",
  "main": "pacotes/desktop/main.ts",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "pacotes/*"
  ],
  "scripts": {
    "start": "node pacotes/servidor/server.ts",
    "dev": "node --watch pacotes/servidor/server.ts",
    "dev:web": "npm run dev -w @gyde/interface",
    "build": "npm run build -w @gyde/interface",
    "check": "tsc -p . && npm run check -w @gyde/interface && eslint .",
    "test": "npm run check && node --test pacotes/servidor/testes/*.test.mjs pacotes/interface/testes/*.test.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "extensoes": "npm run empacotar -w gyde -w @gyde/extensao-chrome",
    "e2e": "node testes-e2e/rodar.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gyde/desktop": "1.0.0",
    "@gyde/servidor": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "build": {
    "appId": "dev.gyde.app",
    "productName": "Gyde",
    "copyright": "Gustavo Moreira Deschamps",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "package.json",
      "pacotes/desktop/main.ts",
      "pacotes/desktop/preload.cjs",
      "pacotes/servidor/*.ts",
      "pacotes/servidor/*.ps1",
      "pacotes/servidor/skills-catalogo/**",
      "pacotes/compartilhado/*.ts",
      "pacotes/interface/dist/**",
      "pacotes/interface/public/icon-512.png",
      "!**/*.map",
      "!node_modules/@gyde/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "pacotes/interface/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gyde",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gustavomdeschamps",
        "repo": "Gyde"
      }
    ]
  }
}
